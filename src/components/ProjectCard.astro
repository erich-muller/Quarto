---
import { formatDate, calculateReadingTime } from '../utils/helpers';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  slug: string;
  tags?: string[];
  heroImage?: string;
  body?: string;
}

const { title, description, publishDate, slug, tags = [], heroImage, body = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readTime = calculateReadingTime(body || description);
---

<article class="group relative flex flex-col bg-white dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark rounded-lg overflow-hidden transition-all duration-200 hover:border-brand-light dark:hover:border-brand-light hover:shadow-md">
  {heroImage && (
    <div class="relative w-full h-48 bg-gray-100 dark:bg-brand-surface-dark-elevated overflow-hidden border-b border-brand-border-light dark:border-brand-border-dark">
      <img
        src={heroImage.startsWith('http') || heroImage.startsWith('/') ? heroImage : `${base}/${heroImage.replace(/^\//, '')}`}
        alt={`Capa do artigo: ${title}`}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}

  <div class="flex-1 p-6 flex flex-col justify-between">
    <div>
      <!-- Metadados: Data e Tempo de Leitura -->
      <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400 mb-3 font-mono">
        <time datetime={publishDate.toISOString()}>
          {formatDate(publishDate)}
        </time>
        <span class="inline-block w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
        <span>{readTime} min de leitura</span>
      </div>

      <!-- Título -->
      <h3 class="text-xl font-bold text-gray-900 dark:text-brand-white group-hover:text-brand-light transition-colors mb-2 line-clamp-2">
        <a href={`${base}/portfolio/${slug}`} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {title}
        </a>
      </h3>

      <!-- Resumo -->
      <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-3 mb-4 leading-relaxed font-normal">
        {description}
      </p>
    </div>

    <!-- Tags e Indicador de Leitura -->
    <div class="pt-4 border-t border-brand-border-light/60 dark:border-brand-border-dark/60 flex items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-light/10 text-brand-light">
            #{tag}
          </span>
        ))}
      </div>
      <span class="text-xs font-semibold text-brand-light group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
        Ler Artigo →
      </span>
    </div>
  </div>
</article>
