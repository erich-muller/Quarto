---
import { formatDate, calculateReadingTime } from '../utils/helpers';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  slug: string;
  tags?: string[];
  heroImage?: string;
  body?: string;
}

const { title, description, publishDate, slug, tags = [], heroImage, body = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readTime = calculateReadingTime(body || description);
const articleUrl = `${base}/portfolio/${slug}`;
---

<article class="group h-full flex flex-col bg-white dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark rounded-xl overflow-hidden transition-all duration-200 hover:border-brand-light dark:hover:border-brand-light hover:shadow-md">
  <!-- Cabeçalho Visual: Imagem de Capa OU Padrão Matemático Abstrato -->
  {heroImage ? (
    <a href={articleUrl} class="block relative w-full h-48 bg-gray-100 dark:bg-brand-surface-dark-elevated overflow-hidden border-b border-brand-border-light dark:border-brand-border-dark flex-shrink-0" tabindex="-1" aria-hidden="true">
      <img
        src={heroImage.startsWith('http') || heroImage.startsWith('/') ? heroImage : `${base}/${heroImage.replace(/^\//, '')}`}
        alt={`Capa do artigo: ${title}`}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </a>
  ) : (
    <a href={articleUrl} class="block relative w-full h-48 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-brand-bg-dark dark:to-brand-surface-dark border-b border-brand-border-light dark:border-brand-border-dark p-6 flex flex-col justify-between overflow-hidden flex-shrink-0" tabindex="-1" aria-hidden="true">
      <!-- Padrão vetorial sutil de malha matemática -->
      <svg class="absolute inset-0 w-full h-full text-brand-light/10 dark:text-brand-light/15 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <pattern id={`grid-${slug}`} width="30" height="30" patternUnits="userSpaceOnUse">
            <path d="M 30 0 L 0 0 0 30" fill="none" stroke="currentColor" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#grid-${slug})`} />
      </svg>

      <div class="relative z-10 flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-brand-light px-2 py-0.5 rounded bg-brand-light/10 border border-brand-light/20">
          Δ Delta Data
        </span>
        <span class="text-xs font-mono text-gray-400 dark:text-gray-500">
          DMA / UFV
        </span>
      </div>

      <div class="relative z-10 flex items-baseline justify-between">
        <span class="font-mono text-3xl font-extrabold text-brand-light/40 group-hover:text-brand-light/70 transition-colors">
          f(x)
        </span>
        <span class="text-xs font-mono text-gray-500 dark:text-gray-400">
          White-Box Study
        </span>
      </div>
    </a>
  )}

  <!-- Corpo do Card -->
  <div class="flex-1 p-6 flex flex-col justify-between">
    <div>
      <!-- Metadados: Data e Tempo de Leitura -->
      <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400 mb-3 font-mono">
        <time datetime={publishDate.toISOString()}>
          {formatDate(publishDate)}
        </time>
        <span class="inline-block w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
        <span>{readTime} min de leitura</span>
      </div>

      <!-- Título Clicável -->
      <h3 class="text-xl font-bold text-gray-900 dark:text-brand-white group-hover:text-brand-light transition-colors mb-3 line-clamp-2">
        <a href={articleUrl} class="hover:underline">
          {title}
        </a>
      </h3>

      <!-- Resumo -->
      <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-3 mb-6 leading-relaxed font-normal">
        {description}
      </p>
    </div>

    <!-- Tags e Botão "Ler Artigo" Clicável e Acessível -->
    <div class="pt-4 border-t border-brand-border-light/60 dark:border-brand-border-dark/60 flex items-center justify-between gap-3">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 2).map((tag) => (
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-light/10 text-brand-light">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Botão Clicável -->
      <a
        href={articleUrl}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-light bg-brand-light/10 hover:bg-brand-light hover:text-white rounded-md transition-all flex-shrink-0"
        aria-label={`Ler artigo completo: ${title}`}
      >
        <span>Ler Artigo</span>
        <span class="text-sm leading-none">→</span>
      </a>
    </div>
  </div>
</article>
