---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-brand-border-light dark:border-brand-border-dark bg-brand-surface-light dark:bg-brand-surface-dark transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Coluna 1: Identidade e Missão -->
      <div class="space-y-4 md:col-span-1">
        <a href={`${base}/`} class="inline-block" aria-label="Quarto Analytics">
          <img
            src={`${base}/images/logo/logo-light.png`}
            alt="Quarto Analytics"
            class="h-8 w-auto block dark:hidden object-contain"
          />
          <img
            src={`${base}/images/logo/logo-dark.png`}
            alt="Quarto Analytics"
            class="h-8 w-auto hidden dark:block object-contain"
          />
        </a>
        <p class="text-sm text-brand-muted-light dark:text-brand-muted-dark leading-relaxed">
          Consultoria especializada em engenharia de dados, business intelligence e inteligência artificial aplicada. Transformando complexidade técnica em vantagem competitiva mensurável.
        </p>
      </div>

      <!-- Coluna 2: Navegação Institucional -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-4">
          Empresa
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={`${base}/`} class="text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light transition-colors">
              Página Inicial
            </a>
          </li>
          <li>
            <a href={`${base}/sobre`} class="text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light transition-colors">
              Sobre Nós & Metodologia
            </a>
          </li>
          <li>
            <a href={`${base}/servicos`} class="text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light transition-colors">
              Soluções & Consultoria
            </a>
          </li>
          <li>
            <a href={`${base}/portfolio`} class="text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light transition-colors">
              Portfólio & Artigos
            </a>
          </li>
          <li>
            <a href={`${base}/contato`} class="text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light transition-colors">
              Contato
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 3: Especialidades Técnicas -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-4">
          Especialidades
        </h3>
        <ul class="space-y-2.5 text-sm text-brand-muted-light dark:text-brand-muted-dark">
          <li>Modern Data Stack & Lakehouse</li>
          <li>Modelagem Preditiva & Machine Learning</li>
          <li>Business Intelligence & Dashboards Executivos</li>
          <li>Governança e Qualidade de Dados</li>
          <li>Otimização Algorítmica e Precificação</li>
        </ul>
      </div>

      <!-- Coluna 4: Contato & Acesso Editorial -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-4">
          Conectar
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="mailto:contato@quartoanalytics.com.br" class="text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light transition-colors flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              contato@quartoanalytics.com.br
            </a>
          </li>
          <li>
            <a href="https://github.com/erich-muller/Quarto" target="_blank" rel="noopener noreferrer" class="text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light transition-colors flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-light" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              Repositório GitHub
            </a>
          </li>
          <li class="pt-2">
            <a
              href={`${base}/admin/`}
              class="inline-flex items-center gap-1.5 text-xs text-brand-light hover:underline font-mono bg-brand-light/10 px-2 py-1 rounded"
              title="Painel de autoria via Decap CMS"
            >
              <span>⚙</span> Painel Editorial (CMS)
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Linha Inferior: Copyright -->
    <div class="mt-12 pt-8 border-t border-brand-border-light dark:border-brand-border-dark flex flex-col sm:flex-row items-center justify-between text-xs text-brand-muted-light dark:text-brand-muted-dark gap-4">
      <p>
        © {currentYear} Quarto Analytics & Consultoria de Dados. Todos os direitos reservados.
      </p>
      <div class="flex items-center gap-6">
        <span>Arquitetura Estática com Astro & Tailwind</span>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-light"></span>
        <span>Deploy GitHub Pages</span>
      </div>
    </div>
  </div>
</footer>

