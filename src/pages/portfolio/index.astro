---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const articles = await getCollection('portfolio');
const sortedArticles = articles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Extrai tags únicas
const allTags = Array.from(
  new Set(articles.flatMap((article) => article.data.tags || []))
).sort();
---

<BaseLayout
  title="Portfólio de Projetos & Artigos Técnicos"
  description="Biblioteca técnica com estudos de caso, algoritmos de machine learning, pipelines de engenharia de dados e modelagem estatística da Quarto Analytics."
>
  <!-- Cabeçalho da Seção -->
  <section class="py-16 sm:py-20 border-b border-brand-border-light dark:border-brand-border-dark bg-brand-surface-light dark:bg-brand-surface-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-light/10 text-brand-light border border-brand-light/20 mb-4">
        Acervo Técnico
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-dark dark:text-brand-white tracking-tight mb-4">
        Estudos de Caso & Artigos Técnicos
      </h1>
      <p class="text-lg text-brand-muted-light dark:text-brand-muted-dark leading-relaxed mb-8">
        Explorações aprofundadas com fundamentação matemática, implementações reproduzíveis e métricas empíricas de projetos executados pela nossa equipe.
      </p>

      <!-- Barra de Pesquisa e Filtros -->
      <div class="space-y-4">
        <div class="relative">
          <input
            id="article-search"
            type="search"
            placeholder="Pesquisar por título, tecnologia ou conceito..."
            class="w-full px-4 py-3 pl-11 rounded-md text-sm bg-brand-bg-light dark:bg-brand-dark border border-brand-border-light dark:border-brand-border-dark text-brand-dark dark:text-brand-white placeholder-brand-muted-light dark:placeholder-brand-muted-dark focus:outline-none focus:ring-2 focus:ring-brand-light"
          />
          <svg
            class="w-5 h-5 absolute left-3.5 top-3.5 text-brand-muted-light dark:text-brand-muted-dark"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Filtros por Tag -->
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <button
            type="button"
            data-tag="all"
            class="tag-filter-btn px-3 py-1 text-xs font-medium rounded-md bg-brand-light text-white transition-colors"
          >
            Todos ({articles.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="tag-filter-btn px-3 py-1 text-xs font-medium rounded-md bg-brand-surface-light dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark text-brand-dark dark:text-brand-white hover:border-brand-light transition-colors"
            >
              #{tag}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Grade de Artigos -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedArticles.map((article) => (
        <div
          class="article-item"
          data-title={article.data.title.toLowerCase()}
          data-desc={article.data.description.toLowerCase()}
          data-tags={JSON.stringify(article.data.tags.map((t: string) => t.toLowerCase()))}
        >
          <ProjectCard
            title={article.data.title}
            description={article.data.description}
            publishDate={article.data.publishDate}
            slug={article.slug}
            tags={article.data.tags}
            heroImage={article.data.heroImage}
            body={article.body}
          />
        </div>
      ))}
    </div>

    <!-- Mensagem de Nenhum Resultado Encontrado -->
    <div id="no-results-msg" class="hidden py-16 text-center text-brand-muted-light dark:text-brand-muted-dark">
      <p class="text-lg font-semibold mb-1">Nenhum artigo encontrado para os critérios selecionados.</p>
      <p class="text-sm">Tente redefinir a busca ou selecionar outra categoria.</p>
    </div>
  </section>

  <!-- Script de Filtro Dinâmico e Busca -->
  <script is:inline>
    function setupPortfolioFilters() {
      const searchInput = document.getElementById('article-search');
      const tagButtons = document.querySelectorAll('.tag-filter-btn');
      const articles = document.querySelectorAll('.article-item');
      const noResults = document.getElementById('no-results-msg');

      let activeTag = 'all';
      let searchQuery = '';

      function filterArticles() {
        let visibleCount = 0;

        articles.forEach((item) => {
          const title = item.getAttribute('data-title') || '';
          const desc = item.getAttribute('data-desc') || '';
          const tags = JSON.parse(item.getAttribute('data-tags') || '[]');

          const matchesSearch =
            searchQuery === '' ||
            title.includes(searchQuery) ||
            desc.includes(searchQuery) ||
            tags.some((t) => t.includes(searchQuery));

          const matchesTag =
            activeTag === 'all' ||
            tags.includes(activeTag.toLowerCase());

          if (matchesSearch && matchesTag) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          noResults?.classList.remove('hidden');
        } else {
          noResults?.classList.add('hidden');
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase();
          filterArticles();
        });
      }

      tagButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          tagButtons.forEach((b) => {
            b.classList.remove('bg-brand-light', 'text-white');
            b.classList.add('bg-brand-surface-light', 'dark:bg-brand-surface-dark');
          });
          btn.classList.remove('bg-brand-surface-light', 'dark:bg-brand-surface-dark');
          btn.classList.add('bg-brand-light', 'text-white');

          activeTag = btn.getAttribute('data-tag') || 'all';
          filterArticles();
        });
      });
    }

    setupPortfolioFilters();
    document.addEventListener('astro:after-swap', setupPortfolioFilters);
  </script>
</BaseLayout>

