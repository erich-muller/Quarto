---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
  {
    id: 'engenharia',
    title: 'Engenharia de Plataformas de Dados & Lakehouse',
    badge: 'Infraestrutura & Pipelines',
    desc: 'Arquitetamos plataformas analíticas elásticas, resilientes e abertas. Eliminamos silos de dados com pipelines de ingestão contínua em formato Apache Iceberg, orquestração robusta e controle rigoroso de esquemas.',
    deliverables: [
      'Ingestão contínua em streaming (Kafka/Pulsar) e batch eficiente',
      'Camadas Medallion (Bronze, Silver, Gold) com isolamento ACID',
      'Orquestração declarativa e modular com dbt e Airflow / Dagster',
      'Testes automatizados de consistência, unicidade e não-nulidade',
    ],
    techs: ['Apache Iceberg', 'dbt', 'DuckDB', 'Trino', 'PostgreSQL', 'Snowflake', 'BigQuery'],
  },
  {
    id: 'bi',
    title: 'Business Intelligence & Camada Semântica Unificada',
    badge: 'Métricas & Visualização',
    desc: 'Construímos a "única fonte da verdade" para a sua diretoria. Padronizamos definições de KPIs, reduzimos discordâncias entre áreas de negócio e entregamos painéis de alta fidelidade visual e tempo de resposta instantâneo.',
    deliverables: [
      'Definição de dicionário de métricas e governança de catálogo',
      'Modelagem dimensional (Kimball / Star Schema) de alta performance',
      'Dashboards executivos e operacionais orientados à tomada de ação',
      'Redução drástica no tempo de carregamento de relatórios analíticos',
    ],
    techs: ['Power BI', 'Metabase', 'Tableau', 'Cube.js', 'Looker Studio', 'SQL Avançado'],
  },
  {
    id: 'ml',
    title: 'Machine Learning & Ciência de Dados Aplicada',
    badge: 'Modelos Preditivos',
    desc: 'Desenvolvemos motores estatísticos e algoritmos supervisionados que antecipam comportamentos futuros, otimizam alocação de capital e reduzem perdas operacionais com foco estrito em explicabilidade e validação empírica.',
    deliverables: [
      'Modelagem de Churn e Propensão de Compra com XGBoost / LightGBM',
      'Motores de Precificação Dinâmica e Otimização Não-Linear de Margem',
      'Previsão de Demanda em Séries Temporais com Intervalos de Confiança',
      'Explicabilidade individualizada via SHAP e análise causal',
    ],
    techs: ['Python', 'XGBoost', 'scikit-learn', 'SHAP', 'SciPy', 'PyTorch', 'MLflow'],
  },
  {
    id: 'governanca',
    title: 'Governança de Dados, Qualidade & FinOps Analítico',
    badge: 'Eficiência & Conformidade',
    desc: 'Auditoria de integridade dos dados e controle financeiro das faturas de cloud computing. Eliminamos consultas ineficientes, organizamos permissões de acesso (LGPD/GDPR) e reduzimos custos de armazenamento e processamento.',
    deliverables: [
      'Auditoria de custos de processamento (FinOps em BigQuery/Snowflake/AWS)',
      'Detecção automatizada de anomalias e quebra de contratos de dados',
      'Adequação de linhagem de dados e políticas de privacidade e retenção',
      'Documentação técnica automatizada de fácil manutenção',
    ],
    techs: ['OpenMetadata', 'Great Expectations', 'dbt tests', 'SQLFluff', 'AWS Cost Explorer'],
  },
];
---

<BaseLayout
  title="Serviços de Consultoria em Análise e Engenharia de Dados"
  description="Conheça nossas soluções completas em Engenharia de Dados, Business Intelligence, Machine Learning e Governança Analítica."
>
  <!-- Cabeçalho da Página -->
  <section class="py-16 sm:py-20 border-b border-brand-border-light dark:border-brand-border-dark bg-brand-surface-light dark:bg-brand-surface-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-light/10 text-brand-light border border-brand-light/20 mb-4">
        Soluções Corporativas
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-dark dark:text-brand-white tracking-tight mb-6">
        Soluções sob medida para o ciclo completo dos dados.
      </h1>
      <p class="text-lg text-brand-muted-light dark:text-brand-muted-dark leading-relaxed">
        Do desenho da arquitetura de ingestão à entrega de algoritmos preditivos em produção, atuamos como uma extensão estratégica da sua equipe técnica.
      </p>
    </div>
  </section>

  <!-- Lista Detalhada de Serviços -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-16">
      {services.map((srv, index) => (
        <div id={srv.id} class="p-8 sm:p-10 rounded-xl bg-brand-surface-light dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark hover:border-brand-light dark:hover:border-brand-light transition-all">
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8">
            <div class="flex-1">
              <span class="inline-block px-3 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-brand-light bg-brand-light/10 rounded mb-4">
                {srv.badge}
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-brand-dark dark:text-brand-white tracking-tight mb-4">
                {srv.title}
              </h2>
              <p class="text-base text-brand-muted-light dark:text-brand-muted-dark leading-relaxed mb-6">
                {srv.desc}
              </p>

              <!-- Entregáveis -->
              <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-3">
                Principais Entregáveis:
              </h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-brand-dark/80 dark:text-brand-white/80 mb-6">
                {srv.deliverables.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brand-light font-bold mt-0.5">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <!-- Tecnologias -->
              <div class="flex flex-wrap items-center gap-2 pt-4 border-t border-brand-border-light/60 dark:border-brand-border-dark/60">
                <span class="text-xs font-mono text-brand-muted-light dark:text-brand-muted-dark mr-1">Stack:</span>
                {srv.techs.map((tech) => (
                  <span class="px-2 py-0.5 text-xs font-mono rounded bg-brand-light/5 text-brand-dark dark:text-brand-white border border-brand-border-light dark:border-brand-border-dark">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Botão de Diagnóstico Específico -->
            <div class="lg:w-64 flex flex-col justify-start">
              <a
                href={`${base}/contato?solucao=${encodeURIComponent(srv.title)}`}
                class="w-full text-center px-5 py-3 text-sm font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-md shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-light"
              >
                Solicitar Proposta
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Seção CTA -->
  <section class="py-16 bg-brand-surface-dark-elevated border-t border-brand-border-dark text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight mb-4 text-brand-white">
        Dúvidas sobre qual solução melhor atende ao seu momento atual?
      </h2>
      <p class="text-base text-brand-muted-dark max-w-2xl mx-auto mb-8 leading-relaxed">
        Realizamos uma sessão de diagnóstico preliminar sem compromisso para entender a maturidade analítica da sua empresa e propor o roteiro técnico mais custo-eficiente.
      </p>
      <a
        href={`${base}/contato`}
        class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-md shadow-md transition-colors"
      >
        Agendar Diagnóstico Gratuito
      </a>
    </div>
  </section>
</BaseLayout>

