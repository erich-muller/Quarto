---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
  {
    id: 'coleta',
    title: 'Sistema de Coleta e Estruturação de Dados',
    category: 'Engenharia de Dados',
    objective: 'Transformar operações manuais, descentralizadas ou inexistentes em arquiteturas organizadas prontas para análise.',
    salesScenario: 'Empresas com processos manuais em papel ou mensagens, planilhas dispersas, retrabalho frequente de digitação ou ausência de um histórico digital confiável.',
    deliverables: [
      'Modelagem de bancos de dados relacionais (PostgreSQL, MySQL) e não-relacionais otimizados para consulta',
      'Pipelines automatizados de extração, tratamento e carga (ETL/ELT) em Python e SQL',
      'Formulários integrados e regras de validação de consistência para eliminar erros humanos na entrada de dados',
      'Documentação técnica da arquitetura e dicionário de dados da organização',
    ],
    techs: ['Python', 'SQL', 'PostgreSQL', 'DuckDB', 'APIs REST', 'Google Sheets Automation'],
  },
  {
    id: 'gestao-a-vista',
    title: 'Gestão à Vista (Visualização e Análise Descritiva)',
    category: 'Business Intelligence',
    objective: 'Converter registros operacionais em ferramentas de inteligência visual e operacional de leitura imediata.',
    salesScenario: 'Organizações que acumulam grandes volumes de dados (ERP, CRM, planilhas), mas não conseguem extrair conclusões acionáveis ou identificar tendências em tempo hábil.',
    deliverables: [
      'Dashboards interativos e responsivos (Power BI, Streamlit ou Looker Studio) com filtros dinâmicos de faturamento, estoque, retenção ou produção',
      'Relatórios aprofundados de Análise Exploratória de Dados (EDA) identificando sazonalidades, gargalos e anomalias estatísticas',
      'Indicadores-chave de desempenho (KPIs) desenhados sob medida para a liderança e equipe operacional',
      'Treinamento e capacitação dos usuários internos para interpretação dos painéis',
    ],
    techs: ['Power BI', 'Streamlit', 'Looker Studio', 'Metabase', 'Pandas', 'Seaborn'],
  },
  {
    id: 'modelagem',
    title: 'Relatório de BI e Modelagem (Predição, Otimização e Prescrição)',
    category: 'Matemática Aplicada & ML',
    objective: 'Aplicar modelos estatísticos e matemáticos avançados para prever comportamentos e otimizar rotinas complexas.',
    salesScenario: 'Empresas que precisam prever demanda de produtos, otimizar rotas logísticas, precificar dinamicamente ou projetar cenários de fluxo de caixa sob incerteza.',
    deliverables: [
      'Relatório Técnico Executivo (PDF): Formulação matemática formal do problema, premissas adotadas, limitações do modelo, métricas de validação empírica e recomendações de negócio',
      'Transparência Total (White-Box): Repositório com todo o código-fonte utilizado (Python/R/SQL), documentado linha a linha, sem dependência de plataformas proprietárias fechadas',
      'Scripts e simuladores de cenários com análise de sensibilidade paramétrica',
      'Acompanhamento e validação dos resultados com a orientação de docentes doutores do DMA/UFV',
    ],
    techs: ['Python', 'R', 'scikit-learn', 'SciPy', 'XGBoost', 'Statsmodels', 'Pesquisa Operacional'],
  },
  {
    id: 'pedagogico',
    title: 'Recursos Educacionais em Matemática (Apoio Pedagógico)',
    category: 'Educação Matemática',
    objective: 'Inovar práticas de ensino-aprendizagem alinhando rigor formal, contextualização e diretrizes curriculares nacionais.',
    salesScenario: 'Escolas públicas e privadas, cursos preparatórios, pré-vestibulares e secretarias de educação que buscam superar a defasagem no aprendizado matemático ou modernizar seu currículo.',
    deliverables: [
      'Sequências didáticas completas e planos de aula estruturados por competências e habilidades da BNCC',
      'Listas de exercícios modulares e contextualizadas, gabaritadas com resolução analítica comentada passo a passo',
      'Roteiros práticos para laboratórios de matemática, feiras de ciências e atividades investigativas',
      'Jogos matemáticos autorais, dinâmicas lúdicas de raciocínio lógico e relatórios de validação metodológica',
    ],
    techs: ['BNCC', 'GeoGebra', 'LaTeX / TikZ', 'Metodologias Ativas', 'Laboratórios Investigativos'],
  },
];
---

<BaseLayout
  title="Serviços — Soluções de Dados e Educação Matemática"
  description="Conheça os serviços da Delta Data: Coleta e Estruturação de Dados, Gestão à Vista, Modelagem Matemática e Recursos Educacionais para escolas."
>
  <!-- Cabeçalho de Serviços -->
  <section class="py-16 sm:py-20 border-b border-brand-border-light dark:border-brand-border-dark bg-white dark:bg-brand-bg-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-light/10 text-brand-light border border-brand-light/20 mb-4">
        Soluções & Consultoria
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-brand-white tracking-tight mb-6">
        Nossas Soluções Especializadas
      </h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        Estruturamos a esteira de serviços da Delta Data com foco estrito em três fatores: o problema real do cliente, a solidez da abordagem matemática e o entregável concreto com código documentado e acompanhamento acadêmico.
      </p>
    </div>
  </section>

  <!-- Lista de Serviços Detalhada -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-16">
      {services.map((srv, index) => (
        <div
          id={srv.id}
          class="p-8 sm:p-10 rounded-xl bg-white dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark hover:border-brand-light dark:hover:border-brand-light transition-all scroll-mt-24 shadow-sm"
        >
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8">
            <div class="flex-1">
              <!-- Categoria & Número -->
              <div class="flex items-center gap-3 mb-4">
                <span class="px-2.5 py-0.5 text-xs font-mono font-bold uppercase text-brand-light bg-brand-light/10 rounded">
                  {srv.category}
                </span>
                <span class="text-xs font-mono text-gray-400 dark:text-gray-500">
                  Módulo 0{index + 1}
                </span>
              </div>

              <!-- Título -->
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-brand-white tracking-tight mb-4">
                {srv.title}
              </h2>

              <!-- Objetivo -->
              <div class="p-4 rounded-lg bg-gray-50 dark:bg-brand-bg-dark border border-brand-border-light dark:border-brand-border-dark mb-6">
                <span class="text-xs font-bold uppercase tracking-wider text-brand-light block mb-1">Objetivo Central:</span>
                <p class="text-sm font-medium text-gray-800 dark:text-gray-200 leading-relaxed">
                  {srv.objective}
                </p>
              </div>

              <!-- Cenário de Venda / Para quem é indicado -->
              <div class="mb-6">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">
                  Cenário de Aplicação:
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                  {srv.salesScenario}
                </p>
              </div>

              <!-- Entregáveis Concretos -->
              <div class="mb-6">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-900 dark:text-brand-white mb-3">
                  Entregáveis Concretos:
                </h3>
                <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
                  {srv.deliverables.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-brand-light font-bold mt-0.5">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tecnologias e Ferramentas -->
              <div class="flex flex-wrap items-center gap-2 pt-4 border-t border-brand-border-light/60 dark:border-brand-border-dark/60">
                <span class="text-xs font-mono text-gray-400 dark:text-gray-500 mr-1">Tecnologias:</span>
                {srv.techs.map((tech) => (
                  <span class="px-2 py-0.5 text-xs font-mono rounded bg-gray-100 dark:bg-brand-bg-dark text-gray-700 dark:text-gray-300 border border-brand-border-light dark:border-brand-border-dark">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Coluna de Ação Lateral -->
            <div class="lg:w-64 flex flex-col justify-start">
              <div class="p-6 rounded-lg bg-gray-50 dark:bg-brand-bg-dark border border-brand-border-light dark:border-brand-border-dark space-y-4">
                <div>
                  <div class="text-xs font-mono text-brand-light font-bold">MODELO JÚNIOR</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                    Supervisão de professores doutores do DMA/UFV
                  </div>
                </div>
                <a
                  href={`${base}/contato?interesse=${encodeURIComponent(srv.title)}`}
                  class="block w-full text-center px-4 py-3 text-sm font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-md shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-light active:scale-95"
                >
                  Solicitar Diagnóstico
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Banner de Conversão Final -->
  <section class="py-16 bg-white dark:bg-brand-surface-dark border-t border-brand-border-light dark:border-brand-border-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-brand-white tracking-tight mb-4">
        Não tem certeza de qual solução é a mais indicada para o seu cenário?
      </h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed mb-8">
        Realizamos uma reunião de briefing gratuita para entender a maturidade dos seus dados ou a demanda pedagógica da sua instituição e recomendar o melhor caminho.
      </p>
      <a
        href={`${base}/contato`}
        class="inline-flex items-center justify-center px-8 py-3.5 text-sm font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-md shadow-md transition-colors"
      >
        Agendar Diagnóstico Gratuito com a Delta Data
      </a>
    </div>
  </section>
</BaseLayout>
