---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Página Não Encontrada (404)"
  description="A página solicitada não existe ou foi movida."
>
  <div class="min-h-[60vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="max-w-md">
      <div class="inline-block p-3 rounded-full bg-brand-light/10 text-brand-light mb-6 font-mono text-2xl font-bold">
        404
      </div>
      <h1 class="text-3xl font-extrabold text-brand-dark dark:text-brand-white tracking-tight mb-3">
        Página Não Encontrada
      </h1>
      <p class="text-sm text-brand-muted-light dark:text-brand-muted-dark leading-relaxed mb-8">
        O endereço solicitado não existe em nossa base ou foi reestruturado. Verifique a URL ou retorne à página inicial.
      </p>
      <div class="flex justify-center gap-4">
        <a
          href={`${base}/`}
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-md shadow-sm transition-colors"
        >
          Ir para a Página Inicial
        </a>
        <a
          href={`${base}/portfolio`}
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium text-brand-dark dark:text-brand-white border border-brand-border-light dark:border-brand-border-dark rounded-md hover:border-brand-light transition-colors"
        >
          Ver Portfólio
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

