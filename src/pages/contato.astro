---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqs = [
  {
    question: 'Como uma Empresa Júnior emite notas e contratos?',
    answer:
      'A Delta Data opera sob a regulamentação oficial da Lei Federal nº 13.267/2016 (Lei da Empresa Júnior). Possuímos CNPJ próprio, conta bancária institucional e estamos plenamente habilitados para celebrar contratos formais de prestação de serviços e emitir Notas Fiscais Eletrônicas de Serviços (NFS-e) com total conformidade contábil e jurídica.',
  },
  {
    question: 'A Delta Data atende apenas em Florestal ou remotamente?',
    answer:
      'Atendemos clientes em todo o território nacional. Nossas soluções de engenharia de dados, business intelligence, modelagem estatística e produção de materiais pedagógicos são desenvolvidas utilizando infraestrutura em nuvem, repositórios de código e reuniões periódicas por videoconferência, garantindo agilidade e proximidade sem barreiras geográficas.',
  },
  {
    question: 'Quem garante a qualidade técnica dos projetos entregues?',
    answer:
      'Cada projeto passa por um ciclo duplo de garantia da qualidade: a revisão interna entre gerentes e diretores de projetos da Delta Data e a orientação consultiva direta de professores e pesquisadores doutores do Departamento de Matemática (DMA) da Universidade Federal de Viçosa (UFV), assegurando conformidade metodológica e ausência de erros teóricos.',
  },
];
---

<BaseLayout
  title="Contato Direto & Diagnóstico"
  description="Fale diretamente com os consultores da Delta Data (DMA/UFV) via WhatsApp ou E-mail institucional para agendar um diagnóstico."
>
  <!-- Cabeçalho -->
  <section class="py-16 sm:py-20 border-b border-brand-border-light dark:border-brand-border-dark bg-white dark:bg-brand-bg-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-light/10 text-brand-light border border-brand-light/20 mb-4">
        Canais Oficiais
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-brand-white tracking-tight mb-4">
        Fale Diretamente Conosco
      </h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl mx-auto">
        Sem intermediários comerciais ou formulários longos. Escolha o canal de sua preferência para iniciar uma conversa com nossos consultores técnicos do DMA/UFV.
      </p>
    </div>
  </section>

  <!-- Seção de Canais de Contato Direto -->
  <section class="py-16 sm:py-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Card WhatsApp -->
      <div class="p-8 rounded-xl bg-white dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark flex flex-col justify-between hover:border-brand-light dark:hover:border-brand-light transition-all shadow-sm">
        <div>
          <div class="w-12 h-12 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>
          <span class="text-xs font-mono font-bold text-emerald-500 uppercase tracking-wider block mb-1">
            Atendimento Rápido
          </span>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-brand-white mb-3">
            WhatsApp Comercial
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
            Converse diretamente com nossos consultores para tirar dúvidas, alinhar prazos ou agendar uma reunião de diagnóstico técnico por videoconferência.
          </p>
          <div class="text-lg font-bold text-gray-900 dark:text-brand-white font-mono mb-6">
            (31) 99999-9999
          </div>
        </div>

        <a
          href="https://wa.me/5531999999999?text=Ol%C3%A1%2C%20gostaria%20de%20solicitar%20um%20diagn%C3%B3stico%20com%20a%20Delta%20Data"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full px-6 py-4 text-base font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500 active:scale-98"
        >
          <span>Iniciar Conversa no WhatsApp</span>
          <span>→</span>
        </a>
      </div>

      <!-- Card E-mail Institucional -->
      <div class="p-8 rounded-xl bg-white dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark flex flex-col justify-between hover:border-brand-light dark:hover:border-brand-light transition-all shadow-sm">
        <div>
          <div class="w-12 h-12 rounded-lg bg-brand-light/10 text-brand-light flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <span class="text-xs font-mono font-bold text-brand-light uppercase tracking-wider block mb-1">
            Propostas & Editais
          </span>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-brand-white mb-3">
            E-mail Institucional
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
            Canal oficial para envio de termos de referência, solicitações formais de proposta, convites para projetos educacionais e parcerias corporativas.
          </p>
          <div class="text-base font-bold text-gray-900 dark:text-brand-white font-mono mb-6 break-all">
            contato@deltadata.ufv.br
          </div>
        </div>

        <a
          href="mailto:contato@deltadata.ufv.br?subject=Solicita%C3%A7%C3%A3o%20de%20Diagn%C3%B3stico%20-%20Delta%20Data&body=Ol%C3%A1%20equipe%20Delta%20Data%2C%0A%0AGostaria%20de%20conversar%20sobre%20uma%20oportunidade%20de%20projeto.%0A%0ANome%3A%0AOrganiza%C3%A7%C3%A3o%3A%0A%C3%81rea%20de%20Interesse%3A%0A%0AMensagem%3A%0A"
          class="inline-flex items-center justify-center gap-2 w-full px-6 py-4 text-base font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-brand-light active:scale-98"
        >
          <span>Enviar E-mail Direto</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Informações da Sede Física e Vínculo Acadêmico -->
    <div class="p-8 rounded-xl bg-gray-50 dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-md bg-brand-light/10 text-brand-light flex items-center justify-center flex-shrink-0 mt-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-gray-900 dark:text-brand-white mb-1">
            Localização Física & Sede
          </h4>
          <p class="text-sm text-gray-600 dark:text-gray-300">
            Prédio LEN02 (Sala 06) – Campus Universitário, Universidade Federal de Viçosa, Florestal – MG, CEP 35690-000.
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
            Atendimento presencial com agendamento prévio ou remoto para todo o Brasil.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção de Dúvidas Frequentes (FAQ) -->
  <section class="py-16 bg-gray-50 dark:bg-brand-surface-dark border-t border-brand-border-light dark:border-brand-border-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-light mb-2">
          Transparência & Processos
        </h2>
        <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-brand-white tracking-tight">
          Perguntas Frequentes (FAQ)
        </p>
      </div>

      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="p-6 rounded-lg bg-white dark:bg-brand-bg-dark border border-brand-border-light dark:border-brand-border-dark">
            <h3 class="text-base font-bold text-gray-900 dark:text-brand-white mb-2 flex items-start gap-2">
              <span class="text-brand-light font-bold text-lg leading-none">?</span>
              <span>{faq.question}</span>
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed pl-5">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
