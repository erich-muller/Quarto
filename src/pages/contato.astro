---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Contato & Diagnóstico Técnico"
  description="Entre em contato com os especialistas da Quarto Analytics para discutir projetos de engenharia de dados, machine learning e consultoria analítica."
>
  <section class="py-16 sm:py-20 border-b border-brand-border-light dark:border-brand-border-dark bg-brand-surface-light dark:bg-brand-surface-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-brand-light/10 text-brand-light border border-brand-light/20 mb-4">
        Canais Diretos
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-dark dark:text-brand-white tracking-tight mb-4">
        Vamos conversar sobre seus desafios de dados.
      </h1>
      <p class="text-lg text-brand-muted-light dark:text-brand-muted-dark leading-relaxed">
        Preencha o formulário abaixo ou envie um e-mail direto. Nossos líderes técnicos respondem em até 24 horas úteis com uma avaliação preliminar.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Informações e Canais Diretos -->
      <div class="lg:col-span-1 space-y-8">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-brand-light mb-2">
            Comunicação Direta
          </h2>
          <h3 class="text-xl font-bold text-brand-dark dark:text-brand-white mb-4">
            Canais Oficiais
          </h3>
          <p class="text-sm text-brand-muted-light dark:text-brand-muted-dark leading-relaxed mb-6">
            Preferimos conversas técnicas diretas sem intermediários comerciais ou abordagens genéricas.
          </p>
        </div>

        <div class="p-6 rounded-lg bg-brand-surface-light dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark space-y-4">
          <div>
            <div class="text-xs font-mono text-brand-muted-light dark:text-brand-muted-dark uppercase mb-1">E-mail Corporativo</div>
            <a href="mailto:contato@quartoanalytics.com.br" class="text-sm font-semibold text-brand-light hover:underline break-all">
              contato@quartoanalytics.com.br
            </a>
          </div>

          <div class="pt-4 border-t border-brand-border-light/60 dark:border-brand-border-dark/60">
            <div class="text-xs font-mono text-brand-muted-light dark:text-brand-muted-dark uppercase mb-1">Repositório & Código</div>
            <a href="https://github.com/erich-muller/Quarto" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-brand-light hover:underline flex items-center gap-1.5">
              <span>github.com/erich-muller/Quarto</span>
              <span class="text-xs">↗</span>
            </a>
          </div>

          <div class="pt-4 border-t border-brand-border-light/60 dark:border-brand-border-dark/60">
            <div class="text-xs font-mono text-brand-muted-light dark:text-brand-muted-dark uppercase mb-1">Tempo de Resposta</div>
            <p class="text-xs text-brand-dark dark:text-brand-white font-medium">
              Até 1 dia útil para propostas e diagnósticos técnicos.
            </p>
          </div>
        </div>

        <div class="p-6 rounded-lg bg-brand-light/5 border border-brand-border-light dark:border-brand-border-dark">
          <h4 class="text-xs font-bold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-2">
            Acordo de Confidencialidade (NDA)
          </h4>
          <p class="text-xs text-brand-muted-light dark:text-brand-muted-dark leading-relaxed">
            Caso seu projeto envolva dados sensíveis ou informações proprietárias de mercado, podemos assinar um acordo de confidencialidade mútuo antes do primeiro alinhamento.
          </p>
        </div>
      </div>

      <!-- Formulário de Contato -->
      <div class="lg:col-span-2">
        <div class="p-8 sm:p-10 rounded-xl bg-brand-surface-light dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark">
          <h3 class="text-2xl font-bold text-brand-dark dark:text-brand-white mb-2">
            Solicitar Proposta ou Diagnóstico
          </h3>
          <p class="text-sm text-brand-muted-light dark:text-brand-muted-dark mb-8">
            Descreva brevemente sua infraestrutura atual e objetivos para que possamos direcionar o especialista correto.
          </p>

          <form id="contact-form" class="space-y-6" action="https://formspree.io/f/seu-id-aqui" method="POST">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-2">
                  Nome Completo *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Ex: Carlos Silva"
                  class="w-full px-4 py-3 text-sm rounded-md bg-brand-bg-light dark:bg-brand-dark border border-brand-border-light dark:border-brand-border-dark text-brand-dark dark:text-brand-white placeholder-brand-muted-light dark:placeholder-brand-muted-dark focus:outline-none focus:ring-2 focus:ring-brand-light"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-2">
                  E-mail Corporativo *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="carlos@empresa.com.br"
                  class="w-full px-4 py-3 text-sm rounded-md bg-brand-bg-light dark:bg-brand-dark border border-brand-border-light dark:border-brand-border-dark text-brand-dark dark:text-brand-white placeholder-brand-muted-light dark:placeholder-brand-muted-dark focus:outline-none focus:ring-2 focus:ring-brand-light"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="company" class="block text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-2">
                  Empresa / Organização
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="Ex: FinTech X"
                  class="w-full px-4 py-3 text-sm rounded-md bg-brand-bg-light dark:bg-brand-dark border border-brand-border-light dark:border-brand-border-dark text-brand-dark dark:text-brand-white placeholder-brand-muted-light dark:placeholder-brand-muted-dark focus:outline-none focus:ring-2 focus:ring-brand-light"
                />
              </div>

              <div>
                <label for="solution" class="block text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-2">
                  Área de Interesse
                </label>
                <select
                  id="solution"
                  name="solution"
                  class="w-full px-4 py-3 text-sm rounded-md bg-brand-bg-light dark:bg-brand-dark border border-brand-border-light dark:border-brand-border-dark text-brand-dark dark:text-brand-white focus:outline-none focus:ring-2 focus:ring-brand-light"
                >
                  <option value="Engenharia de Dados">Engenharia de Dados & Lakehouse</option>
                  <option value="Business Intelligence">Business Intelligence & Métricas</option>
                  <option value="Machine Learning">Machine Learning & Ciência de Dados</option>
                  <option value="Governança e Custos">Governança, FinOps & Qualidade de Dados</option>
                  <option value="Diagnóstico Geral">Diagnóstico Geral de Maturidade</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-brand-dark dark:text-brand-white mb-2">
                Descrição do Desafio ou Projeto *
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Conte sobre suas fontes de dados atuais, volume, tecnologias utilizadas ou gargalos analíticos..."
                class="w-full px-4 py-3 text-sm rounded-md bg-brand-bg-light dark:bg-brand-dark border border-brand-border-light dark:border-brand-border-dark text-brand-dark dark:text-brand-white placeholder-brand-muted-light dark:placeholder-brand-muted-dark focus:outline-none focus:ring-2 focus:ring-brand-light"
              ></textarea>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
              <button
                type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-sm font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-md shadow-md transition-all focus:outline-none focus:ring-2 focus:ring-brand-light active:scale-95"
              >
                Enviar Solicitação
              </button>

              <button
                id="mailto-fallback-btn"
                type="button"
                class="text-xs text-brand-muted-light dark:text-brand-muted-dark hover:text-brand-light dark:hover:text-brand-light underline font-mono"
              >
                Prefere enviar pelo seu cliente de e-mail? Clique aqui
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Script para preenchimento de parâmetros de URL e fallback mailto -->
  <script is:inline>
    function setupContactForm() {
      const urlParams = new URLSearchParams(window.location.search);
      const solucaoParam = urlParams.get('solucao');
      const selectElement = document.getElementById('solution');

      if (solucaoParam && selectElement) {
        for (let i = 0; i < selectElement.options.length; i++) {
          if (selectElement.options[i].text.toLowerCase().includes(solucaoParam.toLowerCase())) {
            selectElement.selectedIndex = i;
            break;
          }
        }
      }

      const mailtoBtn = document.getElementById('mailto-fallback-btn');
      if (mailtoBtn) {
        mailtoBtn.addEventListener('click', () => {
          const name = document.getElementById('name')?.value || '';
          const company = document.getElementById('company')?.value || '';
          const solution = document.getElementById('solution')?.value || '';
          const message = document.getElementById('message')?.value || '';

          const subject = encodeURIComponent(`Contato Quarto Analytics - ${company || name || 'Interesse em Consultoria'}`);
          const body = encodeURIComponent(`Olá equipe Quarto Analytics,\n\nNome: ${name}\nEmpresa: ${company}\nÁrea de Interesse: ${solution}\n\nMensagem:\n${message}`);

          window.location.href = `mailto:contato@quartoanalytics.com.br?subject=${subject}&body=${body}`;
        });
      }
    }

    setupContactForm();
    document.addEventListener('astro:after-swap', setupContactForm);
  </script>
</BaseLayout>

