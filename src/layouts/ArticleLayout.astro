---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CodeBlockCopy from '../components/CodeBlockCopy.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { formatDate, calculateReadingTime } from '../utils/helpers';
import '../styles/obsidian.css';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  heroImage?: string;
  tags?: string[];
  author?: string;
  headings: { depth: number; slug: string; text: string }[];
  rawContent?: string;
}

const {
  title,
  description,
  publishDate,
  heroImage,
  tags = [],
  author = 'Equipe Delta Data',
  headings = [],
  rawContent = '',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readTime = calculateReadingTime(rawContent || description);
---

<BaseLayout title={title} description={description} image={heroImage} articleDate={publishDate}>
  <!-- Barra de Cabeçalho do Artigo -->
  <header class="border-b border-brand-border-light dark:border-brand-border-dark bg-white dark:bg-brand-bg-dark py-10 sm:py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Navegação de Retorno -->
      <a
        href={`${base}/portfolio`}
        class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-brand-light hover:underline mb-6 font-mono"
      >
        ← Voltar ao Portfólio & Artigos
      </a>

      <!-- Tags / Categorias -->
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-light/10 text-brand-light border border-brand-light/20">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Título Principal -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-brand-white tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <!-- Resumo Executivo -->
      <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 leading-relaxed mb-6 font-normal">
        {description}
      </p>

      <!-- Metadados de Autoria e Publicação -->
      <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-gray-500 dark:text-gray-400 pt-4 border-t border-brand-border-light/60 dark:border-brand-border-dark/60 font-mono">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-brand-light text-white font-bold flex items-center justify-center text-xs">
            {author.charAt(0)}
          </span>
          <span class="font-medium text-gray-800 dark:text-gray-200">{author}</span>
        </div>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600"></span>
        <time datetime={publishDate.toISOString()}>
          {formatDate(publishDate)}
        </time>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-300 dark:bg-gray-600"></span>
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4 text-brand-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readTime} min de leitura técnica
        </span>
      </div>
    </div>
  </header>

  <!-- Imagem de Capa Opcional -->
  {heroImage && (
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 mb-8">
      <div class="rounded-xl overflow-hidden shadow-lg border border-brand-border-light dark:border-brand-border-dark max-h-[420px] bg-gray-100 dark:bg-brand-surface-dark-elevated">
        <img
          src={heroImage.startsWith('http') || heroImage.startsWith('/') ? heroImage : `${base}/${heroImage.replace(/^\//, '')}`}
          alt={`Capa de ${title}`}
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  )}

  <!-- Área de Conteúdo Estilo Obsidian / Quartz -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
      <!-- Coluna de Leitura Central -->
      <div class="lg:col-span-3">
        <article class="obsidian-prose prose prose-lg dark:prose-invert max-w-none prose-headings:text-gray-900 dark:prose-headings:text-brand-white prose-p:text-gray-800 dark:prose-p:text-gray-200">
          <slot />
        </article>

        <!-- Rodapé do Artigo -->
        <div class="mt-16 pt-8 border-t border-brand-border-light dark:border-brand-border-dark flex flex-col sm:flex-row items-center justify-between gap-4">
          <a
            href={`${base}/portfolio`}
            class="text-sm font-semibold text-brand-light hover:underline flex items-center gap-1"
          >
            ← Voltar para todos os artigos
          </a>
          <a
            href={`${base}/contato`}
            class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-brand-light hover:bg-brand-accent-hover rounded-md shadow-sm transition-colors"
          >
            Falar com a Delta Data
          </a>
        </div>
      </div>

      <!-- Sumário Lateral Fixo (Desktop) -->
      <aside class="hidden lg:block lg:col-span-1">
        <div class="sticky top-28 space-y-6">
          <TableOfContents headings={headings} />

          <div class="p-4 rounded-lg bg-gray-50 dark:bg-brand-surface-dark border border-brand-border-light dark:border-brand-border-dark text-xs">
            <h4 class="font-bold text-gray-900 dark:text-brand-white uppercase tracking-wider mb-2">
              Leitura Otimizada
            </h4>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              Equações matemáticas podem ser ampliadas tocando ou passando o mouse. Imagens e diagramas abrem em modal ao clicar.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- Componentes Utilitários de Artigo -->
  <CodeBlockCopy />
  <ImageLightbox />

  <!-- Script para Renderização Precisa de Callouts Obsidian e Tabelas Responsivas -->
  <script is:inline>
    function renderObsidianCallouts() {
      const blockquotes = document.querySelectorAll('.obsidian-prose blockquote');
      blockquotes.forEach((bq) => {
        if (bq.classList.contains('callout')) return;

        const firstP = bq.querySelector('p');
        if (!firstP) return;

        const firstChild = firstP.firstChild;
        if (!firstChild || firstChild.nodeType !== Node.TEXT_NODE) return;

        const text = firstChild.textContent || '';
        // Captura [!TIPO] e o título estritamente na PRIMEIRA linha
        const match = text.match(/^\[!([A-Za-z]+)\][ \t]*(.*?)(?:\r?\n|$)([\s\S]*)/);
        if (!match) return;

        const calloutType = match[1].toLowerCase();
        const customTitle = match[2].trim();
        const remainingText = match[3];

        // Atualiza o nó de texto para conter APENAS o corpo restante (sem engolir KaTeX ou parágrafos)
        firstChild.textContent = remainingText;

        bq.classList.add('callout', `callout-${calloutType}`);

        // Cria cabeçalho exclusivo do título
        const titleEl = document.createElement('div');
        titleEl.className = 'callout-title';
        const displayTitle = customTitle || calloutType.toUpperCase();
        titleEl.innerHTML = `<span class="callout-icon">✦</span><span>${displayTitle}</span>`;
        bq.insertBefore(titleEl, firstP);

        // Se o primeiro parágrafo ficou vazio (quando havia linha em branco no MD), remove
        if (!firstP.textContent.trim() && firstP.children.length === 0) {
          firstP.remove();
        }
      });
    }

    function wrapResponsiveTables() {
      const tables = document.querySelectorAll('.obsidian-prose table');
      tables.forEach((table) => {
        if (table.parentElement && table.parentElement.classList.contains('table-scroll-container')) return;

        const container = document.createElement('div');
        container.className = 'table-scroll-container overflow-x-auto my-6 rounded-lg border border-brand-border-light dark:border-brand-border-dark';
        table.parentNode.insertBefore(container, table);
        container.appendChild(table);
      });
    }

    function initArticleEnhancements() {
      renderObsidianCallouts();
      wrapResponsiveTables();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initArticleEnhancements);
    } else {
      initArticleEnhancements();
    }
    document.addEventListener('astro:after-swap', initArticleEnhancements);
  </script>
</BaseLayout>
